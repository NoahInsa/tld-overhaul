<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>TLDOverhaul</RootNamespace>
    <AssemblyName>TLDOverhaul</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0649;CS0169;CS0414;CS8981;CA1416</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Game install. Override with:  dotnet build -p:GameDir="D:\Games\TheLongDark" -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\TheLongDark</GameDir>
    <MLDir>$(GameDir)\MelonLoader</MLDir>
    <InteropDir>$(MLDir)\Il2CppAssemblies</InteropDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <!-- MelonLoader / HarmonyX / Il2CppInterop runtime -->
  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(MLDir)\net6\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(MLDir)\net6\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(MLDir)\net6\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(MLDir)\net6\Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(MLDir)\net6\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Unhollowed game assemblies (generated by MelonLoader on first launch) -->
  <ItemGroup>
    <InteropRef Include="$(InteropDir)\*.dll" />
    <Reference Include="@(InteropRef)">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Optional: copy the built DLL into <GameDir>\Mods after build. Off by default.
       Enable with:  dotnet build -p:DeployToGame=true -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(GameDir)\Mods" />
  </Target>

</Project>
